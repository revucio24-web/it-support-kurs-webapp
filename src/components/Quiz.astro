---
interface Option { text: string; correct: boolean; }
interface Q { question: string; options: Option[]; explanation?: string; }
interface Props { questions: Q[]; }
const { questions } = Astro.props;
---
<div class="quiz my-4 border border-gray-200 dark:border-gray-800 rounded p-4" data-quiz>
  {questions.map((q, qi) => (
    <div class="mb-4" data-q={qi}>
      <p class="font-medium mb-2">{qi + 1}. {q.question}</p>
      <div class="space-y-1">
        {q.options.map((o) => (
          <label class="flex items-center gap-2 text-sm">
            <input type="radio" name={`q${qi}`} data-correct={o.correct ? '1' : '0'} />
            <span>{o.text}</span>
          </label>
        ))}
      </div>
      <p class="feedback text-sm mt-1 hidden"></p>
    </div>
  ))}
  <button type="button" class="quiz-submit px-3 py-1 rounded bg-blue-600 text-white text-sm">Auswerten</button>
  <p class="quiz-result text-sm mt-2 font-medium"></p>
</div>
<script is:inline>
  document.querySelectorAll('[data-quiz]').forEach((quiz) => {
    const btn = quiz.querySelector('.quiz-submit');
    btn?.addEventListener('click', () => {
      const qs = quiz.querySelectorAll('[data-q]');
      let score = 0;
      qs.forEach((q) => {
        const sel = q.querySelector('input[type="radio"]:checked');
        const fb = q.querySelector('.feedback');
        if (!sel) { if (fb) { fb.textContent = 'Keine Antwort gewählt.'; fb.classList.remove('hidden'); } return; }
        const correct = sel.getAttribute('data-correct') === '1';
        if (correct) score++;
        if (fb) { fb.textContent = correct ? '✓ Richtig' : '✗ Falsch'; fb.classList.remove('hidden'); fb.classList.toggle('text-green-600', correct); fb.classList.toggle('text-red-600', !correct); }
      });
      const res = quiz.querySelector('.quiz-result');
      if (res) res.textContent = 'Ergebnis: ' + score + ' / ' + qs.length;
    });
  });
</script>
