---
import { getCollection, render } from 'astro:content';
import Lesson from '../../layouts/Lesson.astro';

export async function getStaticPaths() {
  const lessons = await getCollection('lessons');
  return lessons.map((lesson) => ({
    params: { slug: lesson.data.slug },
    props: { lesson },
  }));
}

const { lesson } = Astro.props;
const { Content } = await render(lesson);
const description = `Modul ${lesson.data.module}, Level ${lesson.data.level}: ${lesson.data.title}. Praxisnaher IT-Support-Kurs auf Deutsch mit Quellen.`;
---
<Lesson
  title={lesson.data.title}
  description={description}
  level={lesson.data.level}
  module={lesson.data.module}
  slug={lesson.data.slug}
  last_verified={lesson.data.last_verified}
  windows_version={lesson.data.windows_version}
  sources={lesson.data.sources}
>
  <Content />
</Lesson>
