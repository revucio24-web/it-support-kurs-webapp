---
import Base from '../layouts/Base.astro';
import { getSortedLessons, url } from '../lib/lessons';

const sorted = await getSortedLessons();

// group by module
const modules = new Map();
for (const l of sorted) {
  const m = l.data.module;
  if (!modules.has(m)) modules.set(m, []);
  modules.get(m).push(l);
}

const moduleNames = {
  0: 'Modul 0 – Homelab (Voraussetzung)',
  1: 'Modul 1 – Grundlagen: Rolle, Tickets, SLA, Eskalation',
  2: 'Modul 2 – Hardware',
  3: 'Modul 3 – Windows 11 Grundlagen',
  4: 'Modul 4 – Troubleshooting-Methodik',
  5: 'Modul 5 – Netzwerk-Basics',
  6: 'Modul 6 – Microsoft 365 / Outlook / Teams',
  7: 'Modul 7 – Sicherheit Basics',
  8: 'Modul 8 – Remote-Support',
  9: 'Modul 9 – Windows Tiefe',
  10: 'Modul 10 – Boot & Recovery',
  11: 'Modul 11 – Active Directory & GPO',
  12: 'Modul 12 – Netzwerk Tiefe',
  13: 'Modul 13 – PowerShell',
  14: 'Modul 14 – Software-Deployment, Intune, Entra',
  15: 'Modul 15 – Backup, Recovery, Patch-Management',
  16: 'Modul 16 – Incident & Problem Management (ITIL)',
  17: 'Modul 17 – Abschlussprojekt & Prüfungssimulation',
};
---
<Base title="IT-Support Kurs (Level 1 + 2)">
  <section class="mb-8">
    <h1 class="text-3xl font-bold mb-2">IT-Support Kurs (Level 1 + Level 2)</h1>
    <p class="text-gray-600 dark:text-gray-400">Praxisnaher Kurs auf Deutsch, von null bis professionell. Fortschritt wird lokal gespeichert.</p>
    <div class="mt-4">
      <div class="text-sm mb-1" id="overall-progress" aria-live="polite">Gesamtfortschritt: 0%</div>
      <div
        class="w-full h-2 bg-gray-200 dark:bg-gray-800 rounded"
        role="progressbar"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="0"
        aria-label="Kursfortschritt"
        id="overall-bar-wrap"
      >
        <div id="overall-bar" class="h-2 bg-blue-600 rounded" style="width:0%"></div>
      </div>
    </div>
  </section>

  {Array.from(modules.keys()).sort((a,b)=>a-b).map((m) => (
    <section class="mb-8">
      <h2 class="text-xl font-semibold mb-3">{moduleNames[m as keyof typeof moduleNames] ?? `Modul ${m}`}</h2>
      <ul class="space-y-1">
        {modules.get(m).map((l: any) => (
          <li class="flex items-center gap-2">
            <input type="checkbox" id={`done-${l.data.slug}`} class="lesson-check" data-slug={l.data.slug} />
            <label for={`done-${l.data.slug}`} class="sr-only">{l.data.title} als abgeschlossen markieren</label>
            <a href={url(`/lesson/${l.data.slug}`)} class="hover:underline">{l.data.title}</a>
            <span class="text-xs text-gray-500 dark:text-gray-400">L{l.data.level}</span>
          </li>
        ))}
      </ul>
    </section>
  ))}

  <script is:inline>
    (function () {
      const checks = document.querySelectorAll('.lesson-check');
      checks.forEach((c) => {
        const slug = c.getAttribute('data-slug');
        try {
          if (localStorage.getItem('done:' + slug) === '1') c.checked = true;
        } catch (e) {}
        c.addEventListener('change', () => {
          try {
            if (c.checked) localStorage.setItem('done:' + slug, '1');
            else localStorage.removeItem('done:' + slug);
          } catch (e) {}
          updateOverall();
        });
      });
      function updateOverall() {
        const total = checks.length;
        const d = document.querySelectorAll('.lesson-check:checked').length;
        const pct = total ? Math.round((d / total) * 100) : 0;
        document.getElementById('overall-progress').textContent = 'Gesamtfortschritt: ' + pct + '%';
        document.getElementById('overall-bar').style.width = pct + '%';
        document.getElementById('overall-bar-wrap').setAttribute('aria-valuenow', String(pct));
      }
      updateOverall();
    })();
  </script>
</Base>
