---
import Base from '../layouts/Base.astro';
import { getSortedLessons, url } from '../lib/lessons';

const lessons = await getSortedLessons();
---
<Base title="Suche" description="Volltextsuche über alle Lektionen und die aggregierte Fehler-Datenbank.">
  <section class="mb-6" data-pagefind-ignore>
    <h1 class="text-2xl font-bold mb-2">Suche</h1>
    <p class="text-gray-600 dark:text-gray-400 text-sm">Volltextsuche über alle Lektionen (Pagefind, nach Build verfügbar).</p>
  </section>

  <div id="search">
    <p id="pf-loading" class="text-sm text-gray-600 dark:text-gray-400">Volltextsuche wird geladen…</p>
  </div>

  <div id="fallback" class="mt-6">
    <h2 class="text-lg font-semibold mb-2">Lektionen (Schnellsuche)</h2>
    <input
      id="q"
      type="text"
      placeholder="Titel filtern..."
      aria-label="Lektionen nach Titel filtern"
      class="px-3 py-2 border rounded dark:bg-gray-800 dark:border-gray-700 w-full mb-4 focus-visible:ring-2 focus-visible:ring-blue-600"
    />
    <ul id="lesson-list" class="space-y-1">
      {lessons.map((l) => (
        <li data-title={l.data.title.toLowerCase()}>
          <a href={url(`/lesson/${l.data.slug}`)} class="hover:underline">{l.data.title}</a>
          <span class="text-xs text-gray-500 dark:text-gray-400 ml-2">Modul {l.data.module} · L{l.data.level}</span>
        </li>
      ))}
    </ul>
  </div>

  <script is:inline>
    (function () {
      const q = document.getElementById('q');
      const items = document.querySelectorAll('#lesson-list li');
      q.addEventListener('input', () => {
        const v = q.value.toLowerCase().trim();
        items.forEach((li) => {
          const t = li.getAttribute('data-title') || '';
          li.style.display = !v || t.includes(v) ? '' : 'none';
        });
      });
    })();
  </script>

  <link href={url('/pagefind/pagefind-ui.css')} rel="stylesheet" />
  <script is:inline src={url('/pagefind/pagefind-ui.js')}></script>
  <script is:inline>
    window.addEventListener('DOMContentLoaded', () => {
      const loading = document.getElementById('pf-loading');
      const fallback = document.getElementById('fallback');
      if (window.PagefindUI) {
        if (loading) loading.remove();
        new window.PagefindUI({ element: '#search', showSubResults: true });
        if (fallback) fallback.classList.add('hidden');
      } else if (loading) {
        loading.innerHTML =
          'Die Volltextsuche ist erst nach <code>npm run build</code> verfügbar. Nutze unten die Schnellsuche.';
      }
    });
  </script>
</Base>
